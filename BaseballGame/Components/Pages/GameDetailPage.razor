@page "/game"
@rendermode InteractiveServer
@inject NpbScraperService Scraper

<PageTitle>試合詳細</PageTitle>

<a href="/" class="btn btn-outline-secondary btn-sm mb-3">← 一覧に戻る</a>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>読み込み中...</span>
    </div>
}
else if (detail == null)
{
    <div class="alert alert-warning">試合情報を取得できませんでした。</div>
}
else
{
    <h2 class="mb-1">@detail.Summary.AwayTeam vs @detail.Summary.HomeTeam</h2>
    <div class="fs-1 fw-bold mb-3">
        @(detail.Summary.AwayScore?.ToString() ?? "-") - @(detail.Summary.HomeScore?.ToString() ?? "-")
    </div>
    <span class="badge bg-secondary mb-4">@detail.Summary.Status</span>

    @if (detail.ScoringPlays.Count > 0)
    {
        <h4 class="mt-4">得点シーン</h4>
        <table class="table table-sm">
            <thead><tr><th>回</th><th>チーム</th><th>内容</th></tr></thead>
            <tbody>
                @foreach (var play in detail.ScoringPlays)
                {
                    <tr>
                        <td>@(play.Inning)回</td>
                        <td>@play.Team</td>
                        <td>@play.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="row mt-4">
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.AwayTeam 打撃成績</h4>
            <BattingTable Lines="detail.AwayBatting" />
        </div>
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.HomeTeam 打撃成績</h4>
            <BattingTable Lines="detail.HomeBatting" />
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.AwayTeam 投手成績</h4>
            <PitchingTable Lines="detail.AwayPitching" />
        </div>
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.HomeTeam 投手成績</h4>
            <PitchingTable Lines="detail.HomePitching" />
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "url")]
    public string? DetailUrl { get; set; }

    private BaseballGame.Models.GameDetail? detail;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DetailUrl))
            detail = await Scraper.GetGameDetailAsync(DetailUrl);
        isLoading = false;
    }
}

@page "/game"
@rendermode InteractiveServer
@inject NpbScraperService Scraper
@inject PredictionService Prediction

<PageTitle>試合詳細</PageTitle>

<a href="/" class="btn btn-outline-secondary btn-sm mb-3">← 一覧に戻る</a>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>読み込み中...</span>
    </div>
}
else if (detail == null)
{
    <div class="alert alert-warning">試合情報を取得できませんでした。</div>
}
else
{
    <h2 class="mb-1">@detail.Summary.AwayTeam vs @detail.Summary.HomeTeam</h2>
    <div class="fs-1 fw-bold mb-2">
        @(detail.Summary.AwayScore?.ToString() ?? "-") - @(detail.Summary.HomeScore?.ToString() ?? "-")
    </div>
    <span class="badge bg-secondary mb-3">@detail.Summary.Status</span>

    @* 予告先発（試合前） *@
    @if (detail.Summary.Status == "試合前")
    {
        <div class="mb-3 d-flex align-items-center gap-3 flex-wrap">
            <span class="badge bg-primary">予告先発</span>
            <span>@detail.Summary.AwayTeam: <strong>@(detail.AwayAnnouncedStarter ?? "未定")</strong></span>
            <span class="text-muted">vs</span>
            <span>@detail.Summary.HomeTeam: <strong>@(detail.HomeAnnouncedStarter ?? "未定")</strong></span>
        </div>
    }

    @* 勝敗投手（試合後） *@
    @if (prediction?.HasPitcherResult == true)
    {
        <div class="mb-3 d-flex gap-3 flex-wrap">
            @if (prediction.WinPitcher != null)
            {
                <span><span class="badge bg-success me-1">勝</span>@prediction.WinPitcher</span>
            }
            @if (prediction.LossPitcher != null)
            {
                <span><span class="badge bg-danger me-1">負</span>@prediction.LossPitcher</span>
            }
            @if (prediction.SavePitcher != null)
            {
                <span><span class="badge bg-info text-dark me-1">S</span>@prediction.SavePitcher</span>
            }
        </div>
    }

    @* 試合前予想（終了後は参考表示） *@
    @if (prediction != null)
    {
        var predLabel = detail.Summary.Status == "終了" ? "試合前予想（参考）" : "試合前予想";
        <div class="card mb-4 border-info">
            <div class="card-header bg-info bg-opacity-10 fw-bold">@predLabel</div>
            <div class="card-body">
                <div class="d-flex justify-content-around mb-2">
                    <div class="text-center">
                        <div class="fw-bold">@detail.Summary.AwayTeam</div>
                        <div class="fs-4 fw-bold text-primary">@prediction.AwayWinProbability.ToString("P0")</div>
                    </div>
                    <div class="text-center align-self-center text-muted">vs</div>
                    <div class="text-center">
                        <div class="fw-bold">@detail.Summary.HomeTeam</div>
                        <div class="fs-4 fw-bold text-primary">@prediction.HomeWinProbability.ToString("P0")</div>
                    </div>
                </div>
                @if (prediction.HasRunStats)
                {
                    <div class="small text-muted border-top pt-2">
                        <div class="mb-1">
                            根拠: 今季得失点
                            @if (prediction.HasEraStats)
                            {
                                <span> ＋ 先発ERA補正（ピタゴラス勝率）</span>
                            }
                            else
                            {
                                <span>（ピタゴラス勝率）</span>
                            }
                        </div>
                        <div>
                            @detail.Summary.AwayTeam: @prediction.AwayRunsScored 得点 / @prediction.AwayRunsAllowed 失点
                            @if (prediction.AwayStarterEra.HasValue)
                            {
                                <span class="ms-1 text-secondary">先発ERA @prediction.AwayStarterEra.Value.ToString("F2")</span>
                            }
                        </div>
                        <div>
                            @detail.Summary.HomeTeam: @prediction.HomeRunsScored 得点 / @prediction.HomeRunsAllowed 失点
                            @if (prediction.HomeStarterEra.HasValue)
                            {
                                <span class="ms-1 text-secondary">先発ERA @prediction.HomeStarterEra.Value.ToString("F2")</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* 得点シーン *@
    @if (detail.ScoringPlays.Count > 0)
    {
        <h4 class="mt-3">得点シーン</h4>
        <table class="table table-sm">
            <thead><tr><th>回</th><th>チーム</th><th>打者</th><th>内容</th></tr></thead>
            <tbody>
                @foreach (var play in detail.ScoringPlays)
                {
                    <tr>
                        <td>@(play.Inning)回@(play.IsTop ? "表" : "裏")</td>
                        <td>@play.Team</td>
                        <td>@play.Batter</td>
                        <td>@play.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="row mt-4">
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.AwayTeam 打撃成績</h4>
            <BattingTable Lines="detail.AwayBatting" />
        </div>
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.HomeTeam 打撃成績</h4>
            <BattingTable Lines="detail.HomeBatting" />
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.AwayTeam 投手成績</h4>
            <PitchingTable Lines="detail.AwayPitching" />
        </div>
        <div class="col-12 col-lg-6">
            <h4>@detail.Summary.HomeTeam 投手成績</h4>
            <PitchingTable Lines="detail.HomePitching" />
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "url")]
    public string? DetailUrl { get; set; }

    private BaseballGame.Models.GameDetail? detail;
    private BaseballGame.Models.GamePrediction? prediction;
    private bool isLoading = true;

    /// <summary>
    /// クエリパラメータのURLをもとに試合詳細と勝率予想を取得する
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DetailUrl))
        {
            detail = await Scraper.GetGameDetailAsync(DetailUrl);

            if (detail != null)
            {
                var preds = await Prediction.GetPredictionsAsync([detail.Summary]);
                prediction = preds.FirstOrDefault();
            }
        }
        isLoading = false;
    }
}

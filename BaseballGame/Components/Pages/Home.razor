@page "/"
@rendermode InteractiveServer
@inject NpbScraperService Scraper
@inject NavigationManager Nav

<PageTitle>NPB 今日の試合</PageTitle>

<h1 class="mb-3">今日の試合結果</h1>
<p class="text-muted">@DateTime.Today.ToString("yyyy年MM月dd日")</p>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>読み込み中...</span>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <ul class="nav nav-tabs border-bottom-0">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "cl" ? "active" : "")" @onclick='() => SwitchTab("cl")'>セ・リーグ</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "pl" ? "active" : "")" @onclick='() => SwitchTab("pl")'>パ・リーグ</button>
            </li>
        </ul>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync">更新</button>
    </div>

    @if (activeTab == "pl" && isLoadingPl)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>読み込み中...</span>
        </div>
    }
    else if (DisplayedGames.Count == 0)
    {
        <div class="alert alert-info">本日の試合はありません。</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var game in DisplayedGames)
            {
                pitcherInfo.TryGetValue(game.DetailUrl ?? "", out var p);
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 @(game.IsGiantsGame ? "border-warning" : "")"
                         style="@(game.IsGiantsGame ? "border-width:2px" : "")"
                         role="button"
                         @onclick="() => NavigateToDetail(game)">
                        @if (game.IsGiantsGame)
                        {
                            <div class="card-header bg-warning bg-opacity-25 fw-bold">★ 巨人戦</div>
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="text-center flex-fill">
                                    <div class="fw-bold">@game.AwayTeam</div>
                                    <div class="fs-2 fw-bold">@(game.AwayScore?.ToString() ?? "-")</div>
                                </div>
                                <div class="text-center px-2 text-muted">vs</div>
                                <div class="text-center flex-fill">
                                    <div class="fw-bold">@game.HomeTeam</div>
                                    <div class="fs-2 fw-bold">@(game.HomeScore?.ToString() ?? "-")</div>
                                </div>
                            </div>
                            <div class="text-center mt-2">
                                <span class="badge @StatusBadgeClass(game.Status)">@game.Status</span>
                            </div>

                            @* 投手情報（試合状態別） *@
                            @if (game.Status == "終了" && (p.Win != null || p.Loss != null))
                            {
                                <div class="mt-2 small border-top pt-2 d-flex flex-wrap gap-2">
                                    @if (p.Win != null)
                                    {
                                        <span><span class="badge bg-success me-1">勝</span>@p.Win</span>
                                    }
                                    @if (p.Loss != null)
                                    {
                                        <span><span class="badge bg-danger me-1">負</span>@p.Loss</span>
                                    }
                                    @if (p.Save != null)
                                    {
                                        <span><span class="badge bg-info text-dark me-1">S</span>@p.Save</span>
                                    }
                                </div>
                            }
                            else if (game.Status != "終了" && (p.Away != null || p.Home != null))
                            {
                                <div class="mt-2 small text-muted border-top pt-2">
                                    予告先発: @(p.Away ?? "—") vs @(p.Home ?? "—")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private static readonly HashSet<string> ClTeams = ["巨人", "阪神", "広島", "中日", "ヤクルト", "DeNA"];
    private List<GameResult> DisplayedGames => activeTab == "cl" ? clGames : plGames;
    private static readonly HashSet<string> PlTeams = ["ソフトバンク", "日本ハム", "オリックス", "楽天", "ロッテ", "西武"];

    private List<GameResult> clGames = [];
    private List<GameResult> plGames = [];
    private Dictionary<string, (string? Away, string? Home, string? Win, string? Loss, string? Save)> pitcherInfo = [];
    private bool isLoading = true;
    private bool isLoadingPl = false;
    private bool plLoaded = false;
    private string activeTab = "cl";

    /// <summary>
    /// コンポーネント初期化時にセ・リーグ試合データを読み込む
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadInitialAsync();
    }

    /// <summary>
    /// 全試合を取得してセ・パに振り分け、セ・リーグの投手情報を読み込む
    /// </summary>
    private async Task LoadInitialAsync()
    {
        isLoading = true;
        var allGames = await Scraper.GetTodayResultsAsync();

        clGames = allGames.Where(g => ClTeams.Contains(g.AwayTeam) || ClTeams.Contains(g.HomeTeam)).ToList();
        plGames = allGames.Where(g => PlTeams.Contains(g.AwayTeam) || PlTeams.Contains(g.HomeTeam)).ToList();

        // 初回はセ・リーグのみ取得（パ・リーグはタブ切替時に遅延取得）
        await LoadPitcherInfoAsync(clGames);
        isLoading = false;
    }

    /// <summary>
    /// 指定試合リストの先発・勝敗投手情報を並行取得してキャッシュに保存する
    /// </summary>
    /// <param name="games">投手情報を取得する試合リスト</param>
    private async Task LoadPitcherInfoAsync(List<GameResult> games)
    {
        var tasks = games
            .Where(g => !string.IsNullOrEmpty(g.DetailUrl))
            .Select(async g =>
            {
                var info = await Scraper.GetStartersFromDetailAsync(g.DetailUrl!);
                return (g.DetailUrl!, (info.AwayStarter, info.HomeStarter, info.WinPitcher, info.LossPitcher, info.SavePitcher));
            });
        var results = await Task.WhenAll(tasks);
        foreach (var (url, info) in results)
        {
            pitcherInfo[url] = info;
        }
    }

    /// <summary>
    /// タブを切り替え、パ・リーグ初回切替時に投手情報を遅延取得する
    /// </summary>
    /// <param name="tab">切り替え先のタブID（"cl" または "pl"）</param>
    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "pl" && !plLoaded)
        {
            isLoadingPl = true;
            StateHasChanged();
            await LoadPitcherInfoAsync(plGames);
            plLoaded = true;
            isLoadingPl = false;
        }
    }

    /// <summary>
    /// キャッシュをクリアして試合データと投手情報を再取得する
    /// </summary>
    private async Task ReloadAsync()
    {
        plLoaded = false;
        pitcherInfo.Clear();
        clGames.Clear();
        plGames.Clear();
        await LoadInitialAsync();
        if (activeTab == "pl")
        {
            isLoadingPl = true;
            StateHasChanged();
            await LoadPitcherInfoAsync(plGames);
            plLoaded = true;
            isLoadingPl = false;
        }
    }

    /// <summary>
    /// 試合カードクリック時に詳細ページへ遷移する
    /// </summary>
    /// <param name="game">遷移対象の試合</param>
    private void NavigateToDetail(GameResult game)
    {
        if (!string.IsNullOrEmpty(game.DetailUrl))
        {
            Nav.NavigateTo($"/game?url={Uri.EscapeDataString(game.DetailUrl)}");
        }
    }

    /// <summary>
    /// 試合ステータスに対応するBootstrapバッジCSSクラスを返す
    /// </summary>
    /// <param name="status">試合ステータス（"終了" / "試合中" / その他）</param>
    /// <returns>Bootstrapバッジ用CSSクラス文字列</returns>
    private static string StatusBadgeClass(string status) => status switch
    {
        "終了" => "bg-secondary",
        "試合中" => "bg-danger",
        _ => "bg-light text-dark border"
    };
}

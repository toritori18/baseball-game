@page "/"
@rendermode InteractiveServer
@inject NpbScraperService Scraper
@inject PredictionService Prediction
@inject NavigationManager Nav

<PageTitle>NPB 今日の試合</PageTitle>

<h1 class="mb-3">今日の試合結果</h1>
<p class="text-muted">@DateTime.Today.ToString("yyyy年MM月dd日")</p>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>読み込み中...</span>
    </div>
}
else if (games.Count == 0)
{
    <div class="alert alert-info">本日の試合はありません。</div>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync">更新</button>
    </div>

    <div class="row g-3">
        @foreach (var game in games)
        {
            var pred = predictions.FirstOrDefault(p => p.HomeTeam == game.HomeTeam && p.AwayTeam == game.AwayTeam);
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 @(game.IsGiantsGame ? "border-warning" : "")"
                     style="@(game.IsGiantsGame ? "border-width:2px" : "")"
                     role="button"
                     @onclick="() => NavigateToDetail(game)">
                    @if (game.IsGiantsGame)
                    {
                        <div class="card-header bg-warning bg-opacity-25 fw-bold">★ 巨人戦</div>
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-center flex-fill">
                                <div class="fw-bold">@game.AwayTeam</div>
                                <div class="fs-2 fw-bold">@(game.AwayScore?.ToString() ?? "-")</div>
                            </div>
                            <div class="text-center px-2 text-muted">vs</div>
                            <div class="text-center flex-fill">
                                <div class="fw-bold">@game.HomeTeam</div>
                                <div class="fs-2 fw-bold">@(game.HomeScore?.ToString() ?? "-")</div>
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            <span class="badge @StatusBadgeClass(game.Status)">@game.Status</span>
                        </div>
                        @if (pred != null)
                        {
                            <div class="mt-3 small text-muted border-top pt-2">
                                <div>予想勝率: @game.AwayTeam @pred.AwayWinProbability.ToString("P0") vs @game.HomeTeam @pred.HomeWinProbability.ToString("P0")</div>
                                @if (pred.IsStarterAvailable)
                                {
                                    <div>先発: @(pred.AwayStarterName ?? "—") vs @(pred.HomeStarterName ?? "—")</div>
                                }
                                else
                                {
                                    <div>先発情報なし</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<GameResult> games = [];
    private List<GamePrediction> predictions = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        games = await Scraper.GetTodayResultsAsync();
        predictions = await Prediction.GetPredictionsAsync(games);
        isLoading = false;
    }

    private async Task ReloadAsync()
    {
        await LoadDataAsync();
    }

    private void NavigateToDetail(GameResult game)
    {
        if (!string.IsNullOrEmpty(game.DetailUrl))
            Nav.NavigateTo($"/game?url={Uri.EscapeDataString(game.DetailUrl)}");
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "終了" => "bg-secondary",
        "試合中" => "bg-danger",
        _ => "bg-light text-dark border"
    };
}

@using BaseballGame.Models

<table class="table table-sm table-bordered">
    <thead class="table-light">
        <tr><th>投手</th><th>投球回</th><th>自責点</th><th>結果</th></tr>
    </thead>
    <tbody>
        @if (Lines.Count == 0)
        {
            <tr><td colspan="4" class="text-muted text-center">データなし</td></tr>
        }
        else
        {
            @foreach (var line in Lines)
            {
                <tr>
                    <td>@line.PlayerName</td>
                    <td>@line.InningsPitched</td>
                    <td>@line.EarnedRuns</td>
                    <td>
                        @if (line.IsWin) { <span class="badge bg-success">勝</span> }
                        else if (line.IsLoss) { <span class="badge bg-danger">負</span> }
                        else { <span>-</span> }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public List<PitchingLine> Lines { get; set; } = [];
}
